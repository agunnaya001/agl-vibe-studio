# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LIFI_API_KEY: Optional API key for LI.FI cross-chain bridge and DEX aggregation services.
# Users can configure this via the Secrets panel in the AI Studio UI for higher rate limits.
LIFI_API_KEY="MY_LIFI_API_KEY"

# ETHERSCAN_API_KEY: Unified Etherscan API V2 key for Base (8453), Base Sepolia (84532), and cross-chain EVM contract verification & publishing.
# Single V2 API key supports Base, Ethereum, Arbitrum, Optimism, Polygon, BNB Chain, and all EVM L2s.
ETHERSCAN_API_KEY="MY_ETHERSCAN_API_KEY"

# BASESCAN_API_KEY: Optional BaseScan-specific API key for Base L2 contract verification.
BASESCAN_API_KEY="MY_BASESCAN_API_KEY"

# AI_GATEWAY_API_KEY: Optional API key for AI Gateway services or model proxy endpoints.
# Users can configure this via the Secrets panel in the AI Studio UI.
AI_GATEWAY_API_KEY="MY_AI_GATEWAY_API_KEY"

# BETTER_AUTH_API_KEY: Required for @better-auth/infra Sentinel & Dash plugins.
BETTER_AUTH_API_KEY="MY_BETTER_AUTH_API_KEY"

# BETTER_AUTH_SECRET: Secret used for signing tokens/cookies in Better Auth.
BETTER_AUTH_SECRET="MY_BETTER_AUTH_SECRET"

# BETTER_AUTH_URL: Base URL for Better Auth endpoints.
BETTER_AUTH_URL="https://aistudio.agunnayalabs.xyz"
